FROM golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0 AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/evpn-node-agent ./cmd/evpn-node-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates iproute2 netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/evpn-node-agent /usr/local/bin/evpn-node-agent
ENTRYPOINT ["/usr/local/bin/evpn-node-agent"]
