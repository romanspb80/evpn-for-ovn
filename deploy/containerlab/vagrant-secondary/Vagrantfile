lab_name = ENV.fetch("EVPN_VM_NAME") { abort "EVPN_VM_NAME must identify a newly authorized disposable VM" }
pool_name = ENV.fetch("EVPN_VM_POOL") { abort "EVPN_VM_POOL must name a dedicated pool" }
network_name = ENV.fetch("EVPN_VM_NETWORK") { abort "EVPN_VM_NETWORK must name a dedicated NAT network" }
network_address = ENV.fetch("EVPN_VM_NETWORK_ADDRESS") { abort "EVPN_VM_NETWORK_ADDRESS must be an unused private /24" }
gateway = ENV.fetch("EVPN_VM_GATEWAY") { abort "EVPN_VM_GATEWAY must be inside the dedicated NAT network" }
cpus = Integer(ENV.fetch("EVPN_VM_CPUS", "4"))
memory = Integer(ENV.fetch("EVPN_VM_MEMORY_MB", "12288"))
disk = Integer(ENV.fetch("EVPN_VM_DISK_GB", "128"))

Vagrant.configure("2") do |config|
  config.vm.box = "generic/ubuntu2204"
  config.vm.box_version = "4.3.12"
  config.vm.box_check_update = false
  config.vm.hostname = "evpn-cni-e2e"
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.define lab_name do |vm|
    vm.vm.provider :libvirt do |libvirt|
      libvirt.default_prefix = ""
      libvirt.driver = "kvm"
      libvirt.cpus = cpus
      libvirt.memory = memory
      libvirt.machine_virtual_size = disk
      libvirt.storage_pool_name = pool_name
      libvirt.management_network_name = network_name
      libvirt.management_network_address = network_address
      libvirt.management_network_mode = "nat"
      libvirt.management_network_keep = true
    end
    vm.vm.provision "shell", path: "provision.sh", args: [gateway]
  end
end
