@startdot
digraph Architecture {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.28", ranksep="0.55",
         splines=true, compound=true, newrank=true, outputorder=edgesfirst,
         fontname="DejaVu Sans", labelloc=t, labeljust=l,
         label=<<FONT POINT-SIZE="20" COLOR="#17263C"><B>EVPN-for-OVN</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="11" COLOR="#61738A">Type-2 control and integration for OVN networks</FONT>>];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        fontcolor="#17263C", color="#C4D0DF", fillcolor="white", penwidth=1.2,
        margin="0.22,0.16"];
  edge [color="#7690AA", penwidth=1.4, arrowsize=0.65, fontname="DejaVu Sans", fontsize=9, fontcolor="#566B82"];

  subgraph cluster_integrations {
    label="PLATFORMS & INTEGRATIONS";
    labelloc=t; labeljust=l; fontsize=10; fontname="DejaVu Sans";
    fontcolor="#5F7187"; style="rounded,filled"; color="#DCE5EF";
    fillcolor="#F8FAFD"; margin=16;
    cni [label=<<B>Kubernetes CNI</B><BR/><FONT POINT-SIZE="10" COLOR="#387758">IMPLEMENTED · bounded validation</FONT>>,
         color="#A3CBB7", fillcolor="#F1FAF5", width=2.45];
    standalone [label=<<B>Standalone runtime</B><BR/><FONT POINT-SIZE="10" COLOR="#A37833">PARTIAL · Type-2 paths validated</FONT><BR/><FONT POINT-SIZE="10">OVN platform lifecycle planned</FONT>>,
                color="#A3CBB7", fillcolor="#F1FAF5", width=2.45];
    ovnk [label=<<B>OVN-Kubernetes</B><BR/><FONT POINT-SIZE="10" COLOR="#A37833">PLANNED</FONT>>,
          color="#E5CDA5", fillcolor="#FFFAF1", width=2.0];
    neutron [label=<<B>OpenStack Neutron</B><BR/><FONT POINT-SIZE="10" COLOR="#A37833">PLANNED</FONT>>,
             color="#E5CDA5", fillcolor="#FFFAF1", width=2.0];
    {rank=same; cni; standalone; ovnk; neutron;}
    cni -> standalone -> ovnk -> neutron [style=invis, weight=40];
  }

  subgraph cluster_project {
    label="EVPN-for-OVN  ·  PROJECT RESPONSIBILITIES";
    labelloc=t; labeljust=l; fontsize=10; fontname="DejaVu Sans";
    fontcolor="#35628F"; style="rounded,filled"; color="#A9C6E5";
    fillcolor="#F3F8FF"; penwidth=1.4; margin=18;
    operator [label=<<B>EVPN Operator</B><BR/><FONT POINT-SIZE="10">Kubernetes lifecycle · multi-node experimental</FONT>>,
              color="#9AB9DC", fillcolor="white"];
    subgraph cluster_runtime {
      label="NODE-AGENT · CURRENT RUNTIME";
      labelloc=t; labeljust=l; fontsize=10; fontname="DejaVu Sans";
      fontcolor="#35628F"; style="rounded,filled"; color="#9AB9DC"; fillcolor="white"; margin=14;
      runtime [label=<<B>Runtime adapters</B><BR/><FONT POINT-SIZE="10">Endpoint lifecycle · identity</FONT>>,
               color="#9AB9DC", width=4.0];
      core [label=<<FONT POINT-SIZE="14"><B>EVPN Core</B></FONT><BR/><FONT POINT-SIZE="10" COLOR="#4F6F92">Logical responsibilities · partially independent</FONT><BR/><FONT POINT-SIZE="11">Type-2 import / export · reconciliation</FONT><BR/><FONT POINT-SIZE="11">ownership · fencing · recovery</FONT>>,
            color="#4F86BF", fillcolor="#DEEDFF", penwidth=1.6, width=4.8];
      runtime -> core [color="#5384B4", label="coordinates"];
    }
    integration [label=<<B>Network integration</B><BR/><FONT POINT-SIZE="10">Owned OVN / OVS and Netlink state</FONT>>,
                 color="#9AB9DC", fillcolor="white", width=4.4];
    core -> integration [color="#5384B4", label="reconciles"];
  }

  subgraph cluster_infrastructure {
    label="EXTERNAL COMPONENTS";
    labelloc=t; labeljust=l; fontsize=10; fontname="DejaVu Sans";
    fontcolor="#5F7187"; style="rounded,filled"; color="#DCE5EF";
    fillcolor="#F8FAFD"; margin=16;
    bgp [label=<<B>GoBGP</B><BR/><FONT POINT-SIZE="10">BGP / EVPN control plane</FONT>>, width=2.6];
    manager [label=<<B>k8gobgp</B><BR/><FONT POINT-SIZE="10">Kubernetes speaker configuration</FONT>>, width=2.7];
    ovn [label=<<B>OVN / OVS</B><BR/><FONT POINT-SIZE="10">Network state and workload forwarding</FONT>>, width=3.0];
    {rank=same; bgp; manager; ovn;}
    bgp -> manager -> ovn [style=invis, weight=40];
  }
  cni -> operator [color="#5384B4", label="uses"];
  operator -> runtime [color="#5384B4", label="manages workload"];
  cni -> runtime [color="#5384B4", label="requests attachments"];
  standalone -> runtime [color="#5384B4", label="uses"];
  core -> bgp [color="#5384B4", label="reads / writes routes"];
  integration -> ovn [color="#5384B4", label="integrates"];
  manager -> bgp [constraint=false, color="#8C9AAA", label="configures"];
}
@enddot
