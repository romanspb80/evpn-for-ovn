@startuml
top to bottom direction
skinparam backgroundColor #FCFCFD
skinparam defaultFontName SansSerif
skinparam defaultFontSize 18
skinparam defaultFontColor #172B4D
skinparam shadowing false
skinparam roundCorner 16
skinparam nodesep 45
skinparam ranksep 45
skinparam ArrowColor #475569
skinparam ArrowThickness 2
skinparam rectangle {
  BorderThickness 2
  BackgroundColor #F8FAFC
  BorderColor #475569
}
title EVPN-for-OVN | modular SDN framework

together {
  rectangle "Kubernetes / Multus\nImplemented integration" as K8s #FFF4DB
  rectangle "OpenStack / Neutron\nPLANNED adapter" as Neutron #FFF4DB
  rectangle "Standalone OVN\nPLANNED platform integration" as Standalone #FFF4DB
}
rectangle "EVPN-for-OVN Framework" as Framework #E8F1FF
together {
  rectangle "GoBGP EVPN control plane" as GoBGP #F1F5F9
  rectangle "OVN / OVS data plane" as OVN #F1F5F9
}
rectangle "External EVPN networks" as Peers #F1F5F9

K8s --> Framework
Neutron -[#925C00,dashed]-> Framework
Standalone -[#925C00,dashed]-> Framework
Framework -[#2457A7]-> GoBGP : EVPN routes
Framework --> OVN : network state
GoBGP <-[#2457A7]-> Peers : BGP EVPN
OVN <-[#18724B]-> Peers : VXLAN packets

legend bottom
  Solid: implemented | Dashed + PLANNED: design target
  Blue arrows: route control | Green arrows: packets
endlegend
footer Experimental framework | Details: docs/architecture/framework-first.md
@enduml
