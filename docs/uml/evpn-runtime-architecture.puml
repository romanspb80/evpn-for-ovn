@startdot
digraph KubernetesRuntime {
  graph [rankdir=TB, bgcolor="#FCFCFD", pad="0.18", nodesep="0.18", ranksep="0.30",
         splines=ortho, compound=true, newrank=true, outputorder=edgesfirst,
         fontname="DejaVu Sans", labelloc=t,
         label=<<FONT POINT-SIZE="17" COLOR="#17263C"><B>Kubernetes runtime | logical deployment view</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#61738A">The Node-Agent hosts the Framework; this is not an E2E acceptance topology</FONT>>];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=8,
        fontcolor="#17263C", color="#AAB8C8", fillcolor="white", penwidth=1.1,
        margin="0.11,0.07"];
  edge [fontname="DejaVu Sans", fontsize=7, fontcolor="#566B82",
        color="#7290AD", penwidth=1.1, arrowsize=0.55];

  subgraph cluster_management {
    label="KUBERNETES MANAGEMENT";
    labelloc=t; fontsize=9; fontcolor="#5F7187";
    style="rounded,filled"; color="#DCE5EF"; fillcolor="#F8FAFD"; margin=10;
    api [label=<<B>Kubernetes API</B><BR/><FONT POINT-SIZE="7">EvpnCore · inventory</FONT>>, fillcolor="#F1F5F9"];
    operator [label=<<B>EVPN Core Operator</B><BR/><FONT POINT-SIZE="7">experimental lifecycle</FONT>>, fillcolor="#FFF4DB"];
    multus [label=<<B>Multus / EVPN CNI</B><BR/><FONT POINT-SIZE="7">separately installed</FONT>>, fillcolor="#FFF4DB"];
    bgpconfig [label=<<B>BGPConfiguration CRD</B><BR/><FONT POINT-SIZE="7">optional provider path</FONT>>, fillcolor="#F1F5F9"];
    manager [label=<<B>k8gobgp manager</B><BR/><FONT POINT-SIZE="7">independent Kubernetes provider</FONT>>, fillcolor="#F1F5F9"];
    {rank=same; api; operator; multus;}
    {rank=same; bgpconfig; manager;}
    api -> operator [label="watches"];
    bgpconfig -> manager [label="reconciles"];
  }

  subgraph cluster_worker_a {
    label="WORKER A · NODE-AGENT DAEMONSET";
    labelloc=t; fontsize=8; fontcolor="#35628F";
    style="rounded,filled"; color="#9AB9DC"; fillcolor="#F1F7FF"; margin=9;
    agent_a [label=<<B>Node-Agent A</B><BR/><FONT POINT-SIZE="7">embedded Type-2 core · local journal</FONT>>, fillcolor="#DEEDFF", color="#4F86BF"];
    gobgp_a [label=<<B>GoBGP A</B><BR/><FONT POINT-SIZE="7">speaker</FONT>>];
    linux_a [label=<<B>Linux Netlink</B><BR/><FONT POINT-SIZE="7">owned bridge / VXLAN / FDB</FONT>>];
    ovs_a [label=<<B>ovn-controller + OVS A</B><BR/><FONT POINT-SIZE="7">workload forwarding</FONT>>];
    {rank=same; agent_a; gobgp_a;}
    {rank=same; linux_a; ovs_a;}
    agent_a -> gobgp_a [color="#397AB5", label="Type-2 RIB"];
    agent_a -> linux_a [color="#4479B6", label="reconciles"];
    linux_a -> ovs_a [color="#7C8B9C", label="observed"];
  }

  subgraph cluster_worker_b {
    label="WORKER B · NODE-AGENT DAEMONSET";
    labelloc=t; fontsize=8; fontcolor="#35628F";
    style="rounded,filled"; color="#9AB9DC"; fillcolor="#F1F7FF"; margin=9;
    agent_b [label=<<B>Node-Agent B</B><BR/><FONT POINT-SIZE="7">embedded Type-2 core · local journal</FONT>>, fillcolor="#DEEDFF", color="#4F86BF"];
    gobgp_b [label=<<B>GoBGP B</B><BR/><FONT POINT-SIZE="7">speaker</FONT>>];
    linux_b [label=<<B>Linux Netlink</B><BR/><FONT POINT-SIZE="7">owned bridge / VXLAN / FDB</FONT>>];
    ovs_b [label=<<B>ovn-controller + OVS B</B><BR/><FONT POINT-SIZE="7">workload forwarding</FONT>>];
    {rank=same; agent_b; gobgp_b;}
    {rank=same; linux_b; ovs_b;}
    agent_b -> gobgp_b [color="#397AB5", label="Type-2 RIB"];
    agent_b -> linux_b [color="#4479B6", label="reconciles"];
    linux_b -> ovs_b [color="#7C8B9C", label="observed"];
  }

  ovn_db [shape=cylinder, label=<<B>OVN NBDB / SBDB</B><BR/><FONT POINT-SIZE="7">shared OVN mode</FONT>>,
          fillcolor="#FFF7E7", color="#D99A22"];
  peer [label=<<B>External EVPN peer</B><BR/><FONT POINT-SIZE="7">FRR / GoBGP</FONT>>];
  endpoint [label=<<B>External VTEP / workload</B><BR/><FONT POINT-SIZE="7">EVPN VXLAN packets</FONT>>];
  note [shape=note, style="filled", color="#D8E2ED", fillcolor="#F8FAFC", fontsize=8,
        label="Operator does not install Multus or k8gobgp.\nDaemonSet Ready and inventory acknowledgment are not full health proof."];

  {rank=same; agent_a; agent_b;}
  {rank=same; gobgp_a; gobgp_b;}
  {rank=same; linux_a; linux_b;}
  {rank=same; ovs_a; ovs_b;}
  operator -> agent_a [color="#7C8B9C", label="manages workload"];
  operator -> agent_b [color="#7C8B9C"];
  api -> agent_a [style=dashed, color="#397AB5", label="inventory / acceptance"];
  api -> agent_b [style=dashed, color="#397AB5"];
  agent_a -> api [style=dashed, color="#397AB5", label="acknowledges"];
  agent_b -> api [style=dashed, color="#397AB5"];
  multus -> agent_a [color="#4479B6", label="Unix CNI RPC"];
  multus -> agent_b [color="#4479B6"];
  manager -> gobgp_a [style=dashed, color="#7C8B9C", label="optional speaker management"];
  manager -> gobgp_b [style=dashed, color="#7C8B9C"];
  ovn_db -> ovs_a [color="#7C8B9C", label="SB state"];
  ovn_db -> ovs_b [color="#7C8B9C"];
  ovs_a -> ovs_b [dir=both, color="#7C8B9C", style=dashed, label="shared-OVN Geneve"];
  gobgp_a -> peer [dir=both, color="#397AB5", label="BGP EVPN"];
  gobgp_b -> peer [dir=both, color="#397AB5"];
  ovs_a -> endpoint [dir=both, color="#34846A", label="external VXLAN"];
  ovs_b -> endpoint [dir=both, color="#34846A"];
  {rank=same; peer; endpoint;}
  peer -> endpoint [style=invis, weight=8];
  endpoint -> note [style=invis];
}
@enddot
