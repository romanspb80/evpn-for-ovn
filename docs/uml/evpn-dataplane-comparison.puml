@startdot
digraph Backends {
  graph [rankdir=TB, bgcolor="#FCFCFD", pad="0.22", nodesep="0.25", ranksep="0.38",
         splines=ortho, compound=true, newrank=true, outputorder=edgesfirst,
         fontname="DejaVu Sans", labelloc=t,
         label=<<FONT POINT-SIZE="17" COLOR="#172B4D"><B>One EVPN Framework | alternative integration backends</B></FONT><BR/><FONT POINT-SIZE="9" COLOR="#64748B">GoBGP is the EVPN control plane; OVN/OVS remains the workload forwarding dataplane</FONT>>];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=9,
        fontcolor="#172B4D", color="#64748B", fillcolor="white", penwidth=1.1,
        margin="0.14,0.10"];
  edge [fontname="DejaVu Sans", fontsize=8, fontcolor="#475569",
        color="#475569", penwidth=1.2, arrowsize=0.6];

  subgraph cluster_consumers {
    label="CONSUMERS";
    labelloc=t; fontsize=9; fontcolor="#64748B";
    style="rounded,filled"; color="#D8E2ED"; fillcolor="#F8FAFC"; margin=10;
    cni [label=<<B>Kubernetes CNI / Multus</B><BR/><FONT POINT-SIZE="8">implemented · scoped</FONT>>, fillcolor="#F1FAF5"];
    standalone [label=<<B>Standalone runtime</B><BR/><FONT POINT-SIZE="8">bounded paths implemented</FONT>>, fillcolor="#F1FAF5"];
    future [label=<<B>OVN-K / Neutron</B><BR/><FONT POINT-SIZE="8">proposed integrations</FONT>>, fillcolor="#FFFAF1"];
    {rank=same; cni; standalone; future;}
    cni -> standalone -> future [style=invis, weight=15];
  }

  core [label=<<B>Shared EVPN Core</B><BR/><FONT POINT-SIZE="8">Type-2 route processing · endpoint lifecycle · ownership / recovery</FONT>>,
        fillcolor="#DEEDFF", color="#4F86BF", penwidth=1.5, width=4.4];

  subgraph cluster_backends {
    label="RELEASE-SCOPED PROGRAMMING MODES";
    labelloc=t; fontsize=9; fontcolor="#35628F";
    style="rounded,filled"; color="#A9C6E5"; fillcolor="#F3F8FF"; margin=11;
    netlink [label=<<B>Netlink-Programmed</B><BR/><FONT POINT-SIZE="8">selected v0.1.0 deployment</FONT>>, fillcolor="#E9F3FF", color="#6E9BCB", width=2.8];
    ovsdb [label=<<B>OVSDB-Programmed</B><BR/><FONT POINT-SIZE="8">maintenance / testing only</FONT><BR/><FONT POINT-SIZE="8">outside v0.1.0 deployment</FONT>>, fillcolor="#FFF2DE", color="#D8B47A", width=2.8];
    {rank=same; netlink; ovsdb;}
    netlink -> ovsdb [style=invis, weight=15];
  }

  subgraph cluster_netlink_path {
    label="NETLINK-PROGRAMMED PATH";
    labelloc=t; fontsize=8; fontcolor="#64748B";
    style="rounded,filled"; color="#D8E2ED"; fillcolor="#FFFFFF"; margin=10;
    kernel [label=<<B>Owned Linux integration state</B><BR/><FONT POINT-SIZE="8">bridge / VXLAN / FDB / neighbors</FONT>>];
    controller_n [label=<<B>ovn-controller</B><BR/><FONT POINT-SIZE="8">observes state; programs OVS</FONT>>];
    kernel -> controller_n [color="#7C8B9C", label="observes"];
  }

  subgraph cluster_ovsdb_path {
    label="OVSDB-PROGRAMMED PATH";
    labelloc=t; fontsize=8; fontcolor="#64748B";
    style="rounded,filled"; color="#D8E2ED"; fillcolor="#FFFFFF"; margin=10;
    ovsdb_state [label=<<B>Owned OVN / OVSDB objects</B><BR/><FONT POINT-SIZE="8">localnet LSP · bridge mapping · VXLAN port</FONT>>];
    controller_o [label=<<B>ovn-controller</B><BR/><FONT POINT-SIZE="8">reconciles forwarding state</FONT>>];
    ovsdb_state -> controller_o [color="#7C8B9C", label="reconciles"];
  }

  forwarding [label=<<B>OVN / OVS workload forwarding</B><BR/><FONT POINT-SIZE="8">OVN Geneve within a shared domain; EVPN VXLAN to external VTEPs</FONT>>,
              fillcolor="#EAF7F0", color="#75A88B", width=4.2];
  gobgp [label=<<B>GoBGP</B><BR/><FONT POINT-SIZE="8">BGP / EVPN control plane</FONT>>];
  provider [label=<<B>k8gobgp</B><BR/><FONT POINT-SIZE="8">optional K8s speaker manager</FONT>>];
  peer [label=<<B>External EVPN peer</B><BR/><FONT POINT-SIZE="8">FRR in bounded tests</FONT>>];
  note [shape=note, style="filled", color="#D8E2ED", fillcolor="#F8FAFC",
        label="Netlink state is not a workload dataplane.\nThe OVSDB backend is retained for research / regression.\nNo comparative benchmark or feature-parity claim."];

  cni -> core [color="#4479B6"];
  standalone -> core [color="#4479B6"];
  future -> core [style=dashed, color="#B8873B"];
  core -> netlink [color="#4479B6"];
  core -> ovsdb [color="#B8873B"];
  netlink -> kernel [color="#4479B6", label="reconciles"];
  ovsdb -> ovsdb_state [color="#B8873B", label="programs"];
  controller_n -> forwarding [color="#7C8B9C"];
  controller_o -> forwarding [color="#7C8B9C"];
  core -> gobgp [color="#397AB5", label="RIB / Type-2 paths"];
  provider -> gobgp [color="#7C8B9C", label="optional configuration"];
  gobgp -> peer [dir=both, color="#397AB5", label="BGP EVPN routes"];
  forwarding -> peer [dir=both, color="#34846A", label="external VXLAN packets"];
  peer -> note [style=invis];
}
@enddot
