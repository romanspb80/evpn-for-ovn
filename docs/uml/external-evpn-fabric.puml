@startuml
title OVN workload to external EVPN/VXLAN fabric
top to bottom direction
skinparam backgroundColor #FCFCFD
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam ArrowFontSize 12
skinparam linetype ortho
skinparam ArrowColor #475569
skinparam componentStyle rectangle
skinparam componentBackgroundColor #F8FAFC
skinparam componentBorderColor #64748B
skinparam databaseBackgroundColor #EFF6FF
skinparam databaseBorderColor #64748B
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #94A3B8

package "OVN-managed site — experimental" {
  package "OVN control plane" {
    database "OVN Northbound DB" as NB
    component "ovn-northd" as Northd
    database "OVN Southbound DB" as SB
  }

  package "Local host / chassis" {
    component "Node-Agent\nendpoint observation, authorization,\nType-2 export/import policy" as Agent
    component "GoBGP speaker\nEVPN control plane" as GoBGP
    component "OVN logical switch\nworkload endpoint" as LocalWorkload
    component "ovn-controller" as Controller
    component "Open vSwitch\nbr-int + local VXLAN VTEP" as LocalOVS
    component "Linux Netlink FDB / neighbor\n(supporting state only)" as Netlink
  }
}

package "External EVPN/VXLAN fabric" {
  component "External BGP EVPN speaker\n(for example, FRR reference peer)" as Peer
  cloud "IP underlay" as Underlay
  component "External VTEP" as RemoteVTEP
  component "Remote endpoint" as RemoteWorkload
}

NB -[#64748B,dashed]-> Northd : logical state
Northd -[#64748B,dashed]-> SB : translated state
SB -[#64748B,dashed]-> Controller : chassis programming state
Controller -[#64748B,dashed]-> LocalOVS : configures OVS forwarding

NB -[#64748B,dashed]-> Agent : read logical ports / switches
SB -[#64748B,dashed]-> Agent : read port binding / chassis
LocalOVS -[#64748B,dashed]-> Agent : read and verify OVS state
Agent -[#64748B,dotted]-> GoBGP : AddPath / DeletePath(UUID)
GoBGP -[#64748B,dotted]-> Agent : ListPath EVPN RIB
Agent -[#64748B,dotted]-> Netlink : validated, owned sync state

LocalWorkload -[#334155,bold]-> LocalOVS : local workload forwarding
GoBGP -[#2563EB,dashed]- Peer : BGP EVPN Type-2 route exchange
LocalOVS -[#15803D,bold]right-> Underlay : VXLAN packet path
Underlay -[#15803D,bold]right-> RemoteVTEP : VXLAN / UDP 4789
RemoteVTEP -[#15803D,bold]right-> RemoteWorkload : decapsulated packet

legend bottom
  Blue dashed line: BGP EVPN route exchange (bidirectional)
  Gray dashed arrows: OVN desired state and read-only observation
  Gray dotted arrows: Node-Agent API / reconciliation operations
  Dark solid arrow: local workload forwarding
  Green solid arrows: VXLAN workload packet path
endlegend
@enduml
